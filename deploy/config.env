# Deployment settings for daylo.henfrydls.com. Sourced by the scripts in this folder.
DOMAIN=daylo.henfrydls.com
WEBROOT=/var/www/daylo
CHECKOUT=/opt/daylo-web                 # where the server keeps its clone of this repo
APP_REPO=henfrydls/daylo                # releases and the web demo artifact come from here
DEMO_ARTIFACT=daylo-web-demo
UMAMI_HOST=https://analytics.henfrydls.com
UMAMI_WEBSITE_ID=e5fcf739-d6b1-4c48-9645-55b4fd90b50a   # "Daylo" in Umami
